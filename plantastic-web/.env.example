# Supabase — Flutter-style names (`SUPABASE_*`) are enough:
# `next.config.ts` mirrors them into NEXT_PUBLIC_* for the browser (admin login, etc.).
# You can instead set NEXT_PUBLIC_* only if you prefer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Razorpay publishable key (safe in browser). Same as Flutter `RAZORPAY_KEY_ID`.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# optional server-only alias — returned by /api/razorpay/public-config for the client
RAZORPAY_KEY_ID=

# Edge Functions `razorpay-create-order` / `razorpay-verify-payment` need RAZORPAY_KEY_SECRET
# in the Supabase project secrets (not necessarily in this file).
